# App
NEXT_PUBLIC_ROOT_DOMAIN=kurospace.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server only — for Bachs webhooks updating orders)
# Option A (local): path to the service account JSON file (gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./your-project-firebase-adminsdk-xxxxx.json
# Option B: full JSON as a single line (good for Netlify env UI)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option C: split fields
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Bachs — Kurospace platform merchant (server only)
# Sandbox: sk_sandbox_...  Live: sk_live_...
BACHS_API_KEY=
# Signing secret from Bachs Developer Portal → Webhooks endpoint
BACHS_WEBHOOK_SECRET=
# Optional override (auto-detected from key prefix)
# BACHS_API_BASE=https://sandbox-api.bachs.io

# Custom email provider (later)
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_BASE_URL=
EMAIL_FROM=orders@kurospace.com
